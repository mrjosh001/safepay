# Server-only secrets. Set these in Vercel > Project > Settings > Environment Variables
APP_URL=https://your-safepay-domain
DATABASE_URL=postgres://user:pass@host:5432/db
# manual (default): you paste invoices from Zeus/Phoenix into /admin.html
PROVIDER=manual
ADMIN_PASSWORD=choose-a-long-passphrase
SESSION_SECRET=long-random-string
# Only for PROVIDER=phoenixd (self-hosted server, not the phone app)
PHOENIXD_URL=
PHOENIXD_PASSWORD=
PHOENIXD_WEBHOOK_SECRET=
